{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pack-smart",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // The built SPA is served from the static-asset binding.
  //
  // The `binding` matters: when a Worker has a `main`, any request that does not
  // match a static file is handed to the Worker rather than to the asset router,
  // so `not_found_handling` never fires on its own. The Worker therefore holds an
  // ASSETS binding and forwards non-/api requests to it explicitly, which is what
  // makes a refresh on /my-stuff return index.html instead of 404.
  // NO VERSION PREVIEW URLS. EVER.
  //
  // `wrangler versions upload` gives every version a public, permanent
  // `<version>-pack-smart.<subdomain>.workers.dev` address bound to the REAL D1
  // database — the same bindings as production, because they are these bindings.
  //
  // During #33 one such preview was published with the passphrase deliberately
  // bypassed, so the swipe could be checked on a phone. It was retired by
  // setting `previews_enabled: false` through the API... and the very next
  // `wrangler deploy` turned it straight back on, saying so in its own output:
  //
  //   "Because your 'workers.dev' route is enabled and your 'preview_urls'
  //    setting is not in your Wrangler file, Preview URLs will be enabled for
  //    this deployment by default."
  //
  // An API call is a one-off that the next deploy overwrites. THIS LINE is the
  // setting that survives, because every deploy reapplies it. It is the reason
  // the exposure cannot come back by accident.
  //
  // If a future slice genuinely needs a device preview, do not flip this. Stand
  // up a SEPARATE Worker with its own D1 database and its own seed data, so a
  // preview URL can never reach Alex's real trips.
  "preview_urls": false,

  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pack-smart",
      // Created by `wrangler d1 create pack-smart`. This is an identifier, not a
      // credential — it grants no access on its own, so it is safe to commit.
      // Access comes from the account login and the API token, neither of which
      // is stored here. See technical-docs/07_SETUP.md.
      "database_id": "5fa51467-c39d-42b8-8500-45b8ae67583e",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
