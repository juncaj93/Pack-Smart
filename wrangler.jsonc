{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pack-smart",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],

  // The built SPA is served from the static-asset binding.
  //
  // The `binding` matters: when a Worker has a `main`, any request that does not
  // match a static file is handed to the Worker rather than to the asset router,
  // so `not_found_handling` never fires on its own. The Worker therefore holds an
  // ASSETS binding and forwards non-/api requests to it explicitly, which is what
  // makes a refresh on /my-stuff return index.html instead of 404.
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pack-smart",
      // Placeholder. Alex runs `wrangler d1 create pack-smart` and sends back the
      // printed id; it is an identifier, not a credential. See technical-docs/07_SETUP.md.
      "database_id": "REPLACE_WITH_DATABASE_ID_FROM_WRANGLER_D1_CREATE",
      "migrations_dir": "migrations"
    }
  ],

  "observability": {
    "enabled": true
  }
}
