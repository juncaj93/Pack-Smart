{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // DOM is needed because Playwright's page.evaluate callbacks are typechecked
    // here but execute in the browser, where document and getComputedStyle exist.
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vitest/globals"],
    "outDir": "./dist-types/node",
    "tsBuildInfoFile": "./dist-types/node.tsbuildinfo",
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.visual.config.ts",
    "tests/e2e/**/*.ts",
    // The visual/interaction QA harness: Playwright, Node, and page.evaluate.
    "tests/visual/**/*.ts",
    // Tests for the Node scripts live here rather than under tests/unit/worker:
    // they need Node types, and the Worker project deliberately has none so that
    // Worker code cannot quietly start depending on Node APIs.
    "tests/scripts/**/*.ts",
    // Tests that read real project files (the seed workbook) and so need Node.
    "tests/data/**/*.ts",
    // The source-level guards at the root of tests/unit. They read files off
    // disk — the service worker cannot be imported, and the e2e suite cannot
    // audit itself from inside — so they need Node types. Non-recursive: the
    // `dom` and `worker` subdirectories belong to the app and Worker projects
    // and must keep their own, narrower, lib and types.
    "tests/unit/*.ts"
  ],
  "references": [{ "path": "./tsconfig.shared.json" }]
}
