# Dependencies
node_modules/

# Build output
dist/
dist-types/
*.tsbuildinfo

# Cloudflare / Wrangler local state
.wrangler/
# Any copy of it, too. Reproducing a CI-only failure means running the suite
# against a FRESH database, which means moving the live one aside first — and
# `.wrangler/` does not match `.wrangler-bak-1787137884/`, so a `git add -A`
# swept 7MB of local D1 state into a commit on a public repository. The stray
# copy is the thing to ignore; the habit of taking one is worth keeping.
.wrangler-*/
.mf/

# Secrets — never commit. See technical-docs/07_SETUP.md
.dev.vars
.dev.vars.*
!.dev.vars.example

# Test output
.visual/
test-results/
playwright-report/
blob-report/
coverage/

# Editor / OS
.DS_Store
*.swp
.idea/
.vscode/

# Logs
*.log
npm-debug.log*
